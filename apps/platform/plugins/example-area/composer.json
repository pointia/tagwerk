{
    "name": "tagwerk/example-area",
    "description": "A household area from a plugin, with menu entry, view, route and translations — template and test bed",
    "type": "library",
    "version": "0.1.0",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "tagwerk/plugin-api": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Tagwerk\\ExampleArea\\": "src/"
        }
    },
    "extra": {
        "tagwerk": {
            "provider": "Tagwerk\\ExampleArea\\ExampleAreaServiceProvider",
            "frontend": "frontend"
        }
    }
}
