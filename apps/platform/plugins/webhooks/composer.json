        "tagwerk/plugin-api": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Tagwerk\\Webhooks\\": "src/"
        }
    },
    "extra": {
        "tagwerk": {
            "provider": "Tagwerk\\Webhooks\\WebhooksServiceProvider"
        }
    }
}
